# =============================================================================
# Quantum Edge Vision Platform - Environment Configuration Template
# Copy to `.env` for local development or inject via secret manager in prod.
# NEVER commit `.env` or real cryptographic keys to version control.
# =============================================================================

ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_hex_chars_minimum_in_staging_or_production
INTERNAL_PROXY_SECRET=replace_with_another_64_hex_chars_shared_with_nextjs_proxy

# Token lifetimes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_LEEWAY_SECONDS=10

# Database (async SQLAlchemy 2.x; PostgreSQL recommended at scale)
DATABASE_URL=sqlite+aiosqlite:///./backend/data/quantum_vision.db

# Optional Redis backing for distributed rate limiting
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=

# Strict CORS origins (comma-separated, never '*' in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Security toggles (auto-enabled in production)
COOKIE_SECURE=false

# Compute & upload bounds
MAX_UPLOAD_BYTES=5242880
QISKIT_TIMEOUT_SECONDS=12.0
QISKIT_MAX_WORKERS=4

# Optional first-run admin bootstrap (only creates user if email absent; keep empty in prod after bootstrap)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Platform Administrator

# Frontend Next.js Proxy Target (server-only)
BACKEND_API_ORIGIN=http://localhost:8000

